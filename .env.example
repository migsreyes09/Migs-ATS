# ATS login password (required)
ATS_PASSWORD=your-secure-password-here

# Signs session cookies — use a long random string (required for production)
ATS_SESSION_SECRET=replace-with-a-long-random-string

# Required for the in-app "Change Password" button to update Vercel and redeploy
VERCEL_TOKEN=your-vercel-api-token
VERCEL_PROJECT_ID=your-vercel-project-id

# Optional — only if the project belongs to a Vercel team
# VERCEL_TEAM_ID=team_xxxxxxxx
